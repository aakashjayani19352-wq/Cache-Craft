# =================================================================
# Cache-Craft Backend Environment Configuration
# =================================================================
# Copy this file to .env for local development.
# For Railway deployment: Add these variables in the Railway project dashboard.

# -----------------------------------------------------------------
# 1. LLM API Key (Required for L3 Cloud Inference)
# -----------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------
# 2. Database Connection (PostgreSQL 16 + pgvector)
# -----------------------------------------------------------------
# Local Docker Compose default:
DATABASE_URL=postgresql://cachecraft:cachepassword@localhost:5433/cachecraft_db
# Railway Deployment: Automatically injected when you attach a PostgreSQL database plugin.

# -----------------------------------------------------------------
# 3. In-Memory Cache (Redis 7)
# -----------------------------------------------------------------
# Local Docker Compose default:
REDIS_URL=redis://localhost:6379/0
# Railway Deployment: Automatically injected when you attach a Redis database plugin.

# -----------------------------------------------------------------
# 4. Local LLM Fallback (Optional / Offline Mode)
# -----------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434

# -----------------------------------------------------------------
# 5. Server Port (Railway automatically sets PORT)
# -----------------------------------------------------------------
PORT=8000
