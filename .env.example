# Cache-Craft Environment Configuration
# Copy this file to .env and insert your real credentials.

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL / pgvector Configuration (Optional overrides)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cachecraft
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Configuration (Optional overrides)
REDIS_HOST=localhost
REDIS_PORT=6379

# Ollama Local Daemon URL
OLLAMA_BASE_URL=http://localhost:11434
